{
  "name": "superclerk-social",
  "version": "0.1.0",
  "private": true,
  "description": "Free, open-source social media scheduler built on the Superclerk API",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"PORT=3001 bun --watch server.ts\" \"vite --port 3000\"",
    "build": "vite build",
    "start": "bun server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@fontsource/outfit": "5.2.8",
    "@noble/hashes": "2.2.0",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@superclerk/sdk": "0.1.1",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-router": "1.168.19",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.11",
    "@types/bun": "1.4.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "9.2.1",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.11",
    "typescript": "5.8.2",
    "vite": "7.1.4"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120
  }
}
