{
  "name": "postclerk",
  "version": "0.2.0",
  "private": true,
  "description": "Free, open-source social media scheduler. Sign in with Superclerk.",
  "license": "MIT",
  "homepage": "https://postclerk.io",
  "repository": "github:surgent-dev/postclerk",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc && tsc -p worker"
  },
  "cloudflare": {
    "bindings": {
      "SESSION_SECRET": {
        "description": "Seals each person's sign-in into a cookie. Any random string of 32 or more characters, such as `openssl rand -base64 32` prints."
      },
      "SUPERCLERK_URL": {
        "description": "Superclerk's API. Keep `https://api.superclerk.com`."
      }
    }
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@fontsource/outfit": "5.2.8",
    "@noble/hashes": "2.2.0",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@superclerk/sdk": "0.1.1",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-router": "1.168.19",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "5.20261031.1",
    "@tailwindcss/vite": "4.1.11",
    "@types/node": "24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.11",
    "typescript": "5.8.2",
    "vite": "7.1.4",
    "wrangler": "4.156.2"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120
  }
}
