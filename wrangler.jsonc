{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "postclerk",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "not_found_handling": "single-page-application",
    // The Worker answers these; every other path is the app's own files.
    "run_worker_first": ["/api/*", "/oauth/*", "/mcp"],
  },
  "vars": {
    "SUPERCLERK_URL": "https://api.superclerk.com",
  },
  "observability": {
    "enabled": true,
  },
}
